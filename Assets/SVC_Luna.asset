            = dot(u_xlat16_4.xyz, u_xlat1.xyz);\n    u_xlat16_33 = u_xlat0.x * 0.5
            + 0.5;\n    u_xlat16_4.x = (-_RampSmoothing) * 0.5 + _RampThreshold;\n   
            u_xlat16_14.x = _RampSmoothing * 0.5 + _RampThreshold;\n    u_xlat16_14.x
            = (-u_xlat16_4.x) + u_xlat16_14.x;\n    u_xlat16_33 = u_xlat16_33 + (-u_xlat16_4.x);\n   
