            u_xlat16_2.xyz = u_xlat16_2.xyz + u_xlat16_3.xyz;\n    u_xlat16_3.xyz
            = u_xlat16_2.xyz * vec3(12.9200001, 12.9200001, 12.9200001);\n    u_xlatb1.xyz
