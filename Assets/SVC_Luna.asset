            u_xlat1.xyz = (u_xlatb0.x) ? u_xlat1.xyz : u_xlat16_6.xyz;\n    u_xlat1.w
            = 1.0;\n    u_xlat16_6.x = dot(unity_SHAr, u_xlat1);\n    u_xlat16_6.y
            = dot(unity_SHAg, u_xlat1);\n    u_xlat16_6.z = dot(unity_SHAb, u_xlat1);\n   
            u_xlat16_6.xyz = max(u_xlat16_6.xyz, vec3(0.0, 0.0, 0.0));\n    u_xlat0.xzw
