            = texture(_BaseMap, vs_TEXCOORD1.xy);\n    u_xlat16_4.xyz = u_xlat16_2.xyz
            * _BaseColor.xyz;\n    SV_Target0.w = u_xlat16_2.w * _BaseColor.w;\n   
            u_xlat5.xy = vs_TEXCOORD1.zw * _BumpMap_ST.xy + _BumpMap_ST.zw;\n   
            u_xlat16_5.xy = texture(_BumpMap, u_xlat5.xy).yw;\n    u_xlat16_6.xy
            = u_xlat16_5.yx * vec2(2.0, 2.0) + vec2(-1.0, -1.0);\n    u_xlat16_40
            = dot(u_xlat16_6.xy, u_xlat16_6.xy);\n    u_xlat16_40 = min(u_xlat16_40,
            1.0);\n    u_xlat16_40 = (-u_xlat16_40) + 1.0;\n    u_xlat16_40 = sqrt(u_xlat16_40);\n   
            u_xlat16_6.xy = u_xlat16_6.xy * vec2(_BumpScale);\n    u_xlat16_18.xyz
            = u_xlat16_6.yyy * vs_TEXCOORD3.xyz;\n    u_xlat16_6.xyz = u_xlat16_6.xxx
            * vs_TEXCOORD2.xyz + u_xlat16_18.xyz;\n    u_xlat16_6.xyz = vec3(u_xlat16_40)
            * u_xlat0.xyz + u_xlat16_6.xyz;\n    u_xlatb0.x = _EmissionChannel<5.0;\n   
            if(u_xlatb0.x){\n        u_xlat0.xy = vs_TEXCOORD1.zw * _EmissionMap_ST.xy
            + _EmissionMap_ST.zw;\n        u_xlat16_0 = texture(_EmissionMap, u_xlat0.xy);\n       
