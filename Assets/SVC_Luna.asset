            = clamp(u_xlat16_12, 0.0, 1.0);\n    u_xlat16_3.x = u_xlat16_12 * -2.0
            + 3.0;\n    u_xlat16_12 = u_xlat16_12 * u_xlat16_12;\n    u_xlat16_12
