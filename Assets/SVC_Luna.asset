            vec3 u_xlat16_3;\nmediump vec3 u_xlat16_4;\nmediump vec3 u_xlat16_7;\nmediump
            float u_xlat16_8;\nmediump float u_xlat16_12;\nfloat u_xlat15;\nvoid
            main()\n{\n    u_xlat0.x = dot(vs_NORMAL0.xyz, vs_NORMAL0.xyz);\n   
