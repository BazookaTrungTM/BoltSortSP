            != uint(0)) ? 1.0 : -1.0;\n    u_xlat0.xyz = vec3(u_xlat30) * u_xlat0.xyz;\n   
            u_xlat30 = dot(_WorldSpaceLightPos0.xyz, _WorldSpaceLightPos0.xyz);\n   
