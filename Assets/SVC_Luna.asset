            * 0.5 + _RampThreshold;\n    u_xlat16_2.x = (-u_xlat16_6) + u_xlat16_2.x;\n   
            u_xlat16_10 = _RampSmoothing * 0.5 + _RampThreshold;\n    u_xlat16_6
            = (-u_xlat16_6) + u_xlat16_10;\n    u_xlat16_6 = float(1.0) / u_xlat16_6;\n   
