            u_xlat6 = dot(u_xlat0.xyz, u_xlat0.xyz);\n    u_xlat6 = inversesqrt(u_xlat6);\n   
            u_xlat0.xyz = vec3(u_xlat6) * u_xlat0.xyz;\n    u_xlatb6 = unity_OrthoParams.w==0.0;\n   
