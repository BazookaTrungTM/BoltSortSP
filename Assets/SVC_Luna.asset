            = u_xlat16_0.xyz * _MatCapColor.xyz + u_xlat16_7.xyz;\n    u_xlat16_4.xyz
            = (bool(u_xlatb36)) ? u_xlat5.xyz : u_xlat16_4.xyz;\n    u_xlat16_7.xyz
            = (bool(u_xlatb36)) ? u_xlat16_7.xyz : u_xlat16_8.xyz;\n    u_xlat0.x
            = dot(u_xlat16_6.xyz, u_xlat3.xyz);\n    u_xlat16_40 = u_xlat0.x * 0.5
            + 0.5;\n    u_xlat16_42 = (-_RampSmoothing) * 0.5 + _RampThreshold;\n   
