            float u_xlat16_12;\nfloat u_xlat15;\nvoid main()\n{\n    u_xlat0.x =
            dot(vs_NORMAL0.xyz, vs_NORMAL0.xyz);\n    u_xlat0.x = inversesqrt(u_xlat0.x);\n   
