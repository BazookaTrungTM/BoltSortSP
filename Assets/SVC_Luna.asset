            = u_xlat10_1.yx * vec2(2.0, 2.0) + vec2(-1.0, -1.0);\n    u_xlat16_12
            = dot(u_xlat16_2.xy, u_xlat16_2.xy);\n    u_xlat16_2.xy = u_xlat16_2.xy
