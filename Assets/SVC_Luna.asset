            vs_TEXCOORD2;\nin highp vec4 vs_TEXCOORD3;\nlayout(location = 0) out
            mediump vec4 SV_Target0;\nvec4 u_xlat0;\nmediump vec4 u_xlat16_0;\nbvec2
            u_xlatb0;\nvec4 u_xlat1;\nmediump vec4 u_xlat16_2;\nbvec4 u_xlatb2;\nvec3
