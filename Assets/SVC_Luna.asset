            vec3(u_xlat12) * u_xlat0.xyz;\n    u_xlat1.xy = vs_TEXCOORD1.zw * _BumpMap_ST.xy
            + _BumpMap_ST.zw;\n    u_xlat16_1.xy = texture(_BumpMap, u_xlat1.xy).yw;\n   
            u_xlat16_2.xy = u_xlat16_1.yx * vec2(2.0, 2.0) + vec2(-1.0, -1.0);\n   
