            * u_xlat0.xyz + u_xlat16_2.xyw;\n    u_xlat0.x = dot(_WorldSpaceLightPos0.xyz,
            _WorldSpaceLightPos0.xyz);\n    u_xlat0.x = inversesqrt(u_xlat0.x);\n   
