            vec3 u_xlat16_18;\nfloat u_xlat36;\nbool u_xlatb36;\nmediump float u_xlat16_40;\nmediump
            float u_xlat16_42;\nmediump float u_xlat16_43;\nvoid main()\n{\n    u_xlat0.x
            = dot(vs_NORMAL0.xyz, vs_NORMAL0.xyz);\n    u_xlat0.x = inversesqrt(u_xlat0.x);\n   
            u_xlat0.xyz = u_xlat0.xxx * vs_NORMAL0.xyz;\n    u_xlat36 = ((gl_FrontFacing
            ? 0xffffffffu : uint(0)) != uint(0)) ? 1.0 : -1.0;\n    u_xlat0.xyz =
            vec3(u_xlat36) * u_xlat0.xyz;\n    u_xlat1.xyz = (-vs_TEXCOORD0.xyz)
            + _WorldSpaceCameraPos.xyz;\n    u_xlat36 = dot(u_xlat1.xyz, u_xlat1.xyz);\n   
            u_xlat36 = max(u_xlat36, 0.00100000005);\n    u_xlat16_2.x = inversesqrt(u_xlat36);\n   
            u_xlat1.xyz = u_xlat1.xyz * u_xlat16_2.xxx;\n    u_xlat36 = dot(_WorldSpaceLightPos0.xyz,
            _WorldSpaceLightPos0.xyz);\n    u_xlat36 = inversesqrt(u_xlat36);\n   
