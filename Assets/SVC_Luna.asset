            = (-u_xlat16_42) + u_xlat16_43;\n    u_xlat16_40 = u_xlat16_40 + (-u_xlat16_42);\n   
            u_xlat16_42 = float(1.0) / u_xlat16_43;\n    u_xlat16_40 = u_xlat16_40
            * u_xlat16_42;\n    u_xlat16_40 = clamp(u_xlat16_40, 0.0, 1.0);\n   
