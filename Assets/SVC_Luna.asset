            * vs_TEXCOORD2.xyz + u_xlat16_3.xyz;\n    u_xlat16_2.xyz = vec3(u_xlat16_12)
            * u_xlat0.xyz + u_xlat16_2.xyw;\n    u_xlat0.xy = u_xlat16_2.yy * hlslcc_mtx4x4unity_MatrixV[1].xy;\n   
            u_xlat0.xy = hlslcc_mtx4x4unity_MatrixV[0].xy * u_xlat16_2.xx + u_xlat0.xy;\n   
            u_xlat0.xy = hlslcc_mtx4x4unity_MatrixV[2].xy * u_xlat16_2.zz + u_xlat0.xy;\n   
            u_xlat16_3.xy = u_xlat0.xy * vec2(0.5, 0.5) + vec2(0.5, 0.5);\n    u_xlat16_0.xyz
