            = vec3(u_xlat16_21) * u_xlat16_4.xyz;\n    u_xlat16_3.xyz = u_xlat16_4.xyz
            * _RimColor.xyz + u_xlat16_3.xyz;\n    u_xlat16_4.xyz = (-_SColor.xyz)
            + _HColor.xyz;\n    u_xlat16_4.xyz = vec3(u_xlat16_20) * u_xlat16_4.xyz
