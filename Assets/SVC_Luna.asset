            = dot(u_xlat16_2.xyz, u_xlat0.xyz);\n    u_xlat16_2.x = u_xlat0.x * 0.5
            + 0.5;\n    u_xlat16_7.x = (-_RampSmoothing) * 0.5 + _RampThreshold;\n   
