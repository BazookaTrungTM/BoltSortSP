            u_xlat16_3.xyz = u_xlat16_2.yyy * vs_TEXCOORD3.xyz;\n    u_xlat16_2.xyw
            = u_xlat16_2.xxx * vs_TEXCOORD2.xyz + u_xlat16_3.xyz;\n    u_xlat16_2.xyz
            = vec3(u_xlat16_10) * u_xlat0.xyz + u_xlat16_2.xyw;\n    u_xlat0.xy =
            u_xlat16_2.yy * hlslcc_mtx4x4unity_MatrixV[1].xy;\n    u_xlat0.xy = hlslcc_mtx4x4unity_MatrixV[0].xy
            * u_xlat16_2.xx + u_xlat0.xy;\n    u_xlat0.xy = hlslcc_mtx4x4unity_MatrixV[2].xy
            * u_xlat16_2.zz + u_xlat0.xy;\n    u_xlat16_3.xy = u_xlat0.xy * vec2(0.5,
            0.5) + vec2(0.5, 0.5);\n    u_xlat16_0.xyz = texture(_MatCapTex, u_xlat16_3.xy).xyz;\n   
            u_xlat0.xyz = u_xlat16_0.xyz * _MatCapColor.xyz;\n    u_xlat12 = dot(_WorldSpaceLightPos0.xyz,
            _WorldSpaceLightPos0.xyz);\n    u_xlat12 = inversesqrt(u_xlat12);\n   
            u_xlat1.xyz = vec3(u_xlat12) * _WorldSpaceLightPos0.xyz;\n    u_xlat12
            = dot(u_xlat16_2.xyz, u_xlat1.xyz);\n    u_xlat16_2.x = u_xlat12 * 0.5
            + 0.5;\n    u_xlat16_6.x = (-_RampSmoothing) * 0.5 + _RampThreshold;\n   
