            u_xlat0.x = max(u_xlat0.x, 0.0);\n    vs_TEXCOORD2.w = (-u_xlat0.x) +
            1.0;\n    u_xlat0.xyz = in_TANGENT0.yyy * hlslcc_mtx4x4unity_ObjectToWorld[1].xyz;\n   
