            * u_xlat2.xyz + u_xlat16_1.xyw;\n    u_xlatb2.xy = lessThan(vec4(0.0,
            0.0, 0.0, 0.0), vec4(_SingleIndirectColor, _IndirectIntensity, _SingleIndirectColor,
