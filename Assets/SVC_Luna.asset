            vs_TEXCOORD8;\nvec3 u_xlat0;\nvec4 u_xlat1;\nfloat u_xlat6;\nbool u_xlatb6;\nvoid
            main()\n{\n    u_xlat0.xyz = in_POSITION0.yyy * hlslcc_mtx4x4unity_ObjectToWorld[1].xyz;\n   
